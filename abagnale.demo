# $JDTAUS: abagnale.demo 9701 2026-08-29 06:34:25Z schulte $

# This file serves as a syntax demonstration for the abagnale configuration
# file format. This is not an example portfolio nor any kind of trading advice.
# Larger windows demand larger amounts of RAM (>16GB). The time it takes for
# the application to reload state when restarting depends on the IO
# capabilities of the system and the frequency 'abagnalectl vacuum' is run.
# Plan restarts for any configuration changes accordingly. See abagnale.conf
# for further information.

database target ABAGNALE user schulte
dns-v4 udp://127.0.0.1:53
dns-v6 udp://::1:53
dns-timeout 3s
exchange coinbase cdp-api-key /etc/abagnale/cdp_api_key.json
exchange bitvavo api-key 9b124e565...
exchange bitvavo api-secret 313deedf...

eur_return="0.0005 EUR"
btc_return="0.0005 BTC"
eth_return="0.0001 ETH"
usd_return="0.25 USD"
usdc_return="0.25 USDC"
usdt_return="0.25 USDT"
inr_return="0.25 INR"
gbp_return="0.25 GBP"


#include /etc/abagnale/abagnale-coinbase-all-brl.conf
#include /etc/abagnale/abagnale-coinbase-all-btc.conf
#include /etc/abagnale/abagnale-coinbase-all-cad.conf
#include /etc/abagnale/abagnale-coinbase-all-eth.conf
#include /etc/abagnale/abagnale-coinbase-all-eur.conf
#include /etc/abagnale/abagnale-coinbase-all-gbp.conf
#include /etc/abagnale/abagnale-coinbase-all-inr.conf
#include /etc/abagnale/abagnale-coinbase-all-sgd.conf
#include /etc/abagnale/abagnale-coinbase-all-usdc.conf

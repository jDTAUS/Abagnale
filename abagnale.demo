#include /etc/abagnale/abagnale-bitvavo-648h.conf
#include /etc/abagnale/abagnale-bitvavo-1296h.conf
#include /etc/abagnale/abagnale-bitvavo-all-eur.conf
#include /etc/abagnale/abagnale-bitvavo-all-usdc.conf

# abagnale-coinbase-72h.conf
trade at coinbase using trend return $eur_return window 72h\
	market USDC@EUR\
	demand-timeout-min 2h demand-timeout-max 18h\
	supply-timeout-min 2h supply-timeout-max 18h\
	stop-loss-delay 30m stop-loss-delays 2\
	take-profit-delay 7.5m take-profit-delays 1\
	take-loss-delay 36h take-loss-delays 1

# abagnale-coinbase-108h.conf
trade at coinbase using trend return $eur_return window 108h\
	market ADA@EUR\
	demand-timeout-min 3h demand-timeout-max 27h\
	supply-timeout-min 3h supply-timeout-max 27h\
	stop-loss-delay 45m stop-loss-delays 2\
	take-profit-delay 9m take-profit-delays 1\
	take-loss-delay 54h take-loss-delays 1

# abagnale-coinbase-144h.conf
trade at coinbase using trend return $eur_return window 144h\
	market AAVE@EUR\
	market ICP@EUR\
	demand-timeout-min 4h demand-timeout-max 36h\
	supply-timeout-min 4h supply-timeout-max 36h\
	stop-loss-delay 1h stop-loss-delays 2\
	take-profit-delay 12m take-profit-delays 1\
	take-loss-delay 72h take-loss-delays 1

# abagnale-coinbase-180h.conf
trade at coinbase using trend return $eur_return window 180h\
	market BAT@EUR\
	market UNI@EUR\
	demand-timeout-min 5h demand-timeout-max 45h\
	supply-timeout-min 5h supply-timeout-max 45h\
	stop-loss-delay 75m stop-loss-delays 2\
	take-profit-delay 15m take-profit-delays 1\
	take-loss-delay 90h take-loss-delays 1

